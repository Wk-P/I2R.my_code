# Copy to deploy/.env and fill in.  deploy/.env is git-ignored: it holds secrets.

# Where the experiment data lives on this machine (results/, logs/, paper_contents/, config/ inside it).
DATA_ROOT=/home/YOU/mycode-data
# Image tag = code version you deploy (e.g. v5.0.2), so a result can always be traced to its image.
IMAGE_TAG=latest
PANEL_PORT=8081

# Optional: back up / restore the data with rclone (deploy/data_sync.sh). Remote "name:bucket[/path]".
RCLONE_REMOTE=r2:mycode-data

# Optional: public access through a Cloudflare tunnel (deploy/cloudflare_setup.py fills CF_TUNNEL_TOKEN).
# API token permissions: Account > Cloudflare Tunnel > Edit, Zone > DNS > Edit.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_HOSTNAME=my-code.example.com
CF_TUNNEL_NAME=mycode
CF_TUNNEL_TOKEN=
